--  subgraph_isomorphism.gpr
--  GNAT Project File for Subgraph Isomorphism Problem
--
--  This project file compiles the subgraph isomorphism package
--  and provides a simple test main program.
--
--  Author: Robert Boettcher
--  Date: July 29, 2026

project Subgraph_Isomorphism is

   -- Source directories
   for Source_Dirs use ("src");

   -- Object directory
   for Object_Dir use "obj";

   -- Executable directory
   for Exec_Dir use "bin";

   -- Main program for testing
   for Main use ("test_subgraph.adb");

   -- Compiler options
   for Compiler ("ada") use "gnatmake";

   -- Switches for the Ada compiler
   package Compiler is
      for Default_Switches ("ada") use ("-gnatN", "-gnata", "-gnatw.e", "-O2");
   end Compiler;

   -- Build options
   type Build_Type is ("debug", "release");
   Build_Mode : Build_Type := external ("BUILD_MODE", "release");

   -- Package for build mode specific settings
   package Build is
      case Build_Mode is
         when "debug" =>
            for Default_Switches ("ada") use Compiler.Default_Switches ("ada") & "-g";
         when "release" =>
            for Default_Switches ("ada") use Compiler.Default_Switches ("ada") & "-O3";
      end case;
   end Build;

end Subgraph_Isomorphism;
